# Supabase (Project Settings > API in the Supabase dashboard)
# These two are safe to expose to the browser:
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Server-only. Never expose these to the client or commit them:
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL used for metadata/OG (defaults to https://plugpay.co.ke)
NEXT_PUBLIC_SITE_URL=https://your-site.netlify.app

# Any long random string, used to sign demo session cookies
SESSION_SECRET=change-me-to-a-long-random-string
